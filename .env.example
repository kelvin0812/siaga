# Supabase Postgres connection string (Session pooler or direct connection
# string from Supabase project settings -> Database). Leave unset to run
# against InMemoryRepository instead (offline demo fallback).
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Only needed by the persistent ingest process (backend/app/main.py),
# never by the Vercel REST API.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=

# Path to a Firebase service account JSON. Leave unset to log alerts
# instead of sending them (NullFCMClient) — safe default for a booth demo
# with no configured Firebase project yet.
FIREBASE_CREDENTIALS_PATH=

DENSITY_MIN_SUBSCRIBERS=10
ALERT_BUFFER_RINGS=2
