# Supabase Postgres connection string for the "siaga" project
# (oqsdoubmzzkfgcvvsbfb, ap-southeast-1) — separate from any other
# Supabase project on this account. Get the password from Supabase
# dashboard -> siaga project -> Settings -> Database (not retrievable
# via MCP, and never store it in this repo). Leave DATABASE_URL unset to
# run against InMemoryRepository instead (offline demo fallback).
DATABASE_URL=postgresql://postgres:[password]@db.oqsdoubmzzkfgcvvsbfb.supabase.co:5432/postgres

# Only needed by the persistent ingest process (backend/app/main.py),
# never by the Vercel REST API.
MQTT_HOST=localhost
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USERNAME=
MQTT_PASSWORD=

# Path to a Firebase service account JSON. Leave unset to log alerts
# instead of sending them (NullFCMClient) — safe default for a booth demo
# with no configured Firebase project yet.
FIREBASE_CREDENTIALS_PATH=

DENSITY_MIN_SUBSCRIBERS=10
ALERT_BUFFER_RINGS=2
